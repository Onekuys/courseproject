
    <Window x:Class="OOPWPFProject.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OOPWPFProject"
        mc:Ignorable="d"
        Title="Система бронювання квитків" Height="700" Width="1200" FontSize="14" FontFamily="Verdana"
        >
    <!--Closing="Window_Closing"-->

    <!-- Styles -->
    <Window.Resources>
        
        <!-- Головні кнопки --><!--
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                            CornerRadius="8" 
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#005A9E"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        --><!-- Другорядні кнопки --><!--
        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#CCCCCC"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#AAAAAA"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        --><!-- Блоки вводу тексту --><!--
        <Style TargetType="TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                            BorderBrush="#CCCCCC" 
                            BorderThickness="1" 
                            CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        --><!-- Надписи --><!--
        <Style TargetType="Label">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="0,0,0,5"/>
        </Style>

        --><!-- Список --><!--
        <Style TargetType="ComboBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0,30,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Border" 
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"/>

                            <ToggleButton x:Name="ToggleButton" 
                                  Background="Transparent" 
                                  BorderBrush="Transparent"
                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Grid>
                                            <Border Background="Transparent"/>
                                            <Path x:Name="Arrow" 
                                          Data="M0,0 L4,4 L8,0 Z" 
                                          Fill="#666666" 
                                          HorizontalAlignment="Right" 
                                          VerticalAlignment="Center" 
                                          Margin="0,0,10,0"/>
                                        </Grid>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="ContentSite" 
                                      IsHitTestVisible="False" 
                                      Content="{TemplateBinding SelectionBoxItem}" 
                                      Margin="{TemplateBinding Padding}" 
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" 
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>

                            <Popup x:Name="Popup" 
                           Placement="Bottom" 
                           IsOpen="{TemplateBinding IsDropDownOpen}" 
                           AllowsTransparency="True" 
                           Focusable="False">
                                <Border x:Name="DropDownBorder" 
                                Background="White" 
                                BorderBrush="#CCCCCC" 
                                BorderThickness="1" 
                                CornerRadius="4" 
                                Margin="0,2,0,0"
                                MinWidth="{TemplateBinding ActualWidth}" 
                                MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer>
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#AAAAAA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border Name="Bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Padding="{TemplateBinding Padding}"
                        SnapsToDevicePixels="true">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="true">
                                <Setter TargetName="Bd" Property="Background" Value="#F0F0F0"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="true">
                                <Setter TargetName="Bd" Property="Background" Value="#007ACC"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        --><!-- DataGrid Заголовок --><!--
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="BorderBrush" Value="#005A9E"/>
        </Style>
        
        --><!-- DataGrid --><!--
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#005A9E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowHeight" Value="25"/>
            <Setter Property="AlternatingRowBackground" Value="#F9F9F9"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EEEEEE"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            
        </Style>-->
    </Window.Resources>


    <!-- Форма -->
    <Grid>
        <!-- Список бронювань --><!--
        <Border Grid.Column="1" Background="White" Padding="10">
            <DockPanel>

                <TextBlock DockPanel.Dock="Top" Text="Список бронювань" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>
                --><!-- Сортування --><!--

                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Grid.Column="0">
                        <Label Content="Сортувати за: " VerticalAlignment="Center"/>
                        <ComboBox x:Name="SortComboBox" Width="158" Margin="0,0,10,0" SelectedIndex="0">
                            <ComboBoxItem Content="Назва фільму"/>
                            <ComboBoxItem Content="Час сеансу"/>
                            <ComboBoxItem Content="Номер місця"/>
                        </ComboBox>
                        <Button Content="Сортувати" Click="SortRecords_Click" Style="{StaticResource PrimaryButtonStyle}" Width="100" Height="25"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Right">
                        <Label Content="Знайти за назвою:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox x:Name="SearchNameInput" Width="120" Height="30" Margin="0,0,10,0"/>
                        <Button Content="Пошук" Click="SearchName_Click" Style="{StaticResource PrimaryButtonStyle}" Width="100" Height="25"/>
                    </StackPanel>
                </Grid>

                --><!-- Пошук за індексом --><!--
                <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">

                    <Button x:Name="OpenReservationButton" Content="Додати запис" Click="OpenReservationWindow_Click" Style="{StaticResource PrimaryButtonStyle}" Width="150" Height="30" HorizontalAlignment="Left" />
                    <Button x:Name="DeleteButton" Content="Видалити" Click="DeleteRecord_Click" Style="{StaticResource SecondaryButtonStyle}" Width="150" Height="30" Margin="165,0,0,0" HorizontalAlignment="Left" />
                    <Button x:Name="ExportGroupedButton" Content="Експорт груп" Click="ExportGrouped_Click" Style="{StaticResource SecondaryButtonStyle}" Width="150" Height="30" HorizontalAlignment="Center" />
                    <Button x:Name="CancelButton" Content="Скасувати бронювання"  Click="CancelRecord_Click" Style="{StaticResource SecondaryButtonStyle}" Width="220" Height="30" HorizontalAlignment="Right"/>

                </Grid>

                --><!-- DataGrid --><!--
                <DataGrid x:Name="BookingsDataGrid" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCanceled}" Value="True">
                                    <Setter Property="Foreground" Value="Gray" />
                                    <Setter Property="FontStyle" Value="Italic" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Назва фільму" Binding="{Binding MovieTitle}" Width="*"/>
                        <DataGridTextColumn Header="Час сеансу" Binding="{Binding ShowTime, StringFormat=\{0:hh\\:mm\}}" Width="0.5*"/>
                        <DataGridTextColumn Header="Місце" Binding="{Binding SeatDisplay}" Width="0.5*"/>
                        <DataGridTextColumn Header="Деталі" Binding="{Binding Details}" Width="1.5*"/>
                    </DataGrid.Columns>

                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Об'єднати" Click="GroupRecords_Click">
                                <MenuItem.Icon>
                                    <TextBlock Width="15" Text="+" FontWeight="Bold" TextAlignment="Center" Foreground="#007ACC"/>
                                </MenuItem.Icon>
                            </MenuItem>

                            <MenuItem Header="Збіг часу і місця" Click="CompareEquality_Click">
                                <MenuItem.Icon>
                                    <TextBlock Width="30" Text="==" FontWeight="Bold" TextAlignment="Left" Foreground="#007ACC"/>
                                </MenuItem.Icon>
                            </MenuItem>

                            <MenuItem Header="Який сеанс раніше" Click="CompareTime_Click">
                                <MenuItem.Icon>
                                    <TextBlock Width="30" Text="&lt;&gt;" FontWeight="Bold" TextAlignment="Left" Foreground="#007ACC"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                </DataGrid>
            </DockPanel>

        </Border>-->



    </Grid>

</Window>
