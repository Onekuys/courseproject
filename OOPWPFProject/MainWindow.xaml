<Window x:Class="OOPWPFProject.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OOPWPFProject"
        mc:Ignorable="d"
        Title="Система бронювання квитків" Height="760" Width="1200" 
        FontSize="14" FontFamily="Verdana"
        Background="#F4F6F9"
        Closing="Window_Closing">

    <Window.Resources>
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="14,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#005A9E"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#CCCCCC"/>
                    <Setter Property="Foreground" Value="#888888"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#BDBDBD"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.08" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Label">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#444444"/>
            <Setter Property="Padding" Value="0,0,0,4"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!--DataGrid заголовок-->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="BorderBrush" Value="#005A9E"/>
        </Style>

        <!--DataGrid-->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#005A9E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowHeight" Value="25"/>
            <Setter Property="AlternatingRowBackground" Value="#F9F9F9"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EEEEEE"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Список бронювань" FontSize="22" FontWeight="Bold" Foreground="#1A1A2E" Margin="0,0,0,16"/>

                <DataGrid x:Name="BookingsDataGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCanceled}" Value="True">
                                    <Setter Property="Foreground" Value="Gray" />
                                    <Setter Property="FontStyle" Value="Italic" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Назва фільму" Binding="{Binding MovieTitle}" Width="0.8*"/>
                        <DataGridTextColumn Header="Час" Binding="{Binding ShowTime, StringFormat=\{0:hh\\:mm\}}" Width="0.3*"/>
                        <DataGridTextColumn Header="Формат" Binding="{Binding Format}" Width="0.4*"/>
                        <DataGridTextColumn Header="Місце" Binding="{Binding SeatDisplay}" Width="0.4*"/>
                        <DataGridTextColumn Header="Деталі" Binding="{Binding Details}" Width="1.5*"/>
                    </DataGrid.Columns>

                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Об'єднати" Click="GroupRecords_Click">
                                <MenuItem.Icon>
                                    <TextBlock Width="15" Text="+" FontWeight="Bold" TextAlignment="Center" Foreground="#007ACC"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Збіг часу і місця" Click="CompareEquality_Click">
                                <MenuItem.Icon>
                                    <TextBlock Width="30" Text="==" FontWeight="Bold" TextAlignment="Left" Foreground="#007ACC"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Який сеанс раніше" Click="CompareTime_Click">
                                <MenuItem.Icon>
                                    <TextBlock Width="30" Text="&lt;&gt;" FontWeight="Bold" TextAlignment="Left" Foreground="#007ACC"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                </DataGrid>
            </DockPanel>
        </Border>

        <StackPanel Grid.Column="2">

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Пошук та сортування" FontSize="16" FontWeight="Bold" Foreground="#007ACC" Margin="0,0,0,12"/>

                    <Label Content="Сортувати за:"/>
                    <ComboBox x:Name="SortComboBox" SelectedIndex="0" Margin="0,0,0,8">
                        <ComboBoxItem Content="Назва фільму"/>
                        <ComboBoxItem Content="Час сеансу"/>
                        <ComboBoxItem Content="Номер місця"/>
                    </ComboBox>
                    <Button Content="Сортувати"  Style="{StaticResource PrimaryBtn}" Margin="0,0,0,16"/>

                    <Label Content="Знайти за назвою:"/>
                    <TextBox x:Name="SearchNameInput" Margin="0,0,0,8"/>
                    <Button Content="Пошук"  Style="{StaticResource PrimaryBtn}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Операції" FontSize="16" FontWeight="Bold" Foreground="#007ACC" Margin="0,0,0,12"/>

                    <Button x:Name="OpenReservationButton" Content="Додати запис" Click="OpenReservationWindow_Click" Style="{StaticResource PrimaryBtn}" Margin="0,0,0,10"/>
                    <Button x:Name="CancelButton" Content="Скасувати бронювання" Click="CancelRecord_Click" Style="{StaticResource SecondaryBtn}" Margin="0,0,0,10"/>
                    <Button x:Name="DeleteButton" Content="Видалити" Click="DeleteRecord_Click" Style="{StaticResource SecondaryBtn}" Margin="0,0,0,10"/>
                    

                    <Separator Margin="0,10,0,10" Background="#EEEEEE"/>

                    <Button x:Name="ExportGroupedButton" Content="Експорт груп"  Style="{StaticResource SecondaryBtn}"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </Grid>
</Window>