<Window x:Class="OOPWPFProject.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OOPWPFProject"
        mc:Ignorable="d"
        Title="Бронювання квитків"
        Height="660" Width="1100"
        MinHeight="500" MinWidth="800"
        FontFamily="Segoe UI" FontSize="13"
        Background="#F2F3F5"
        Closing="Window_Closing">

    <!-- СТИЛІ -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>

        <!-- Основна кнопка -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background"   Value="#1A6FC4"/>
            <Setter Property="Foreground"   Value="White"/>
            <Setter Property="FontSize"     Value="12"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"      Value="12,0"/>
            <Setter Property="Height"       Value="28"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#155AA3"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#A8C4E0"/>
                    <Setter Property="Foreground" Value="#D0E4F4"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Червона кнопка -->
        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#C0392B"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#9B2D20"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#E8B4AF"/>
                    <Setter Property="Foreground" Value="#F5D5D0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Помаранчева кнопка -->
        <Style x:Key="WarnBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#D4820A"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#B36E09"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#EECC99"/>
                    <Setter Property="Foreground" Value="#F5E4C0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Кнопка-фільтр -->
        <Style x:Key="FilterChip" TargetType="ToggleButton">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="Foreground"      Value="#5A6270"/>
            <Setter Property="BorderBrush"     Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Padding"         Value="10,3"/>
            <Setter Property="Height"          Value="24"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background"  Value="#E3EFFC"/>
                    <Setter Property="Foreground"  Value="#1A6FC4"/>
                    <Setter Property="BorderBrush" Value="#93BEE8"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEF2F7"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding"                  Value="8,0"/>
            <Setter Property="Height"                   Value="28"/>
            <Setter Property="FontSize"                 Value="12"/>
            <Setter Property="Foreground"               Value="#2D3142"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox -->
        <Style TargetType="ComboBox">
            <Setter Property="Height"       Value="28"/>
            <Setter Property="FontSize"     Value="12"/>
            <Setter Property="Background"   Value="White"/>
            <Setter Property="BorderBrush"  Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"      Value="8,0,24,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="5"/>
                            <ToggleButton Background="Transparent" BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                          RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Grid>
                                            <Border Background="Transparent"/>
                                            <Path Data="M0,0 L4,4 L8,0 Z" Fill="#666"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Margin="0,0,8,0"/>
                                        </Grid>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False">
                                <Border Background="White" BorderBrush="#D1D5DB" BorderThickness="1"
                                        CornerRadius="5" Margin="0,2,0,0"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer>
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F0F5FB"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E3EFFC"/>
                                <Setter Property="Foreground" Value="#1A6FC4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cells -->
        <Style x:Key="IdGridCell" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="12,0,0,0"/>
        </Style>

        <Style x:Key="MovieGridCell" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="12,0"/>
        </Style>

        <Style x:Key="CenterGridCell" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>


        <!-- DataGrid -->
        <Style TargetType="DataGrid">
            <Setter Property="Background"              Value="White"/>
            <Setter Property="BorderThickness"         Value="0"/>
            <Setter Property="RowHeight"               Value="32"/>
            <Setter Property="GridLinesVisibility"     Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#F0F1F3"/>
            <Setter Property="AlternatingRowBackground" Value="#FAFBFC"/>
            <Setter Property="RowBackground"           Value="White"/>
            <Setter Property="HeadersVisibility"       Value="Column"/>
            <Setter Property="SelectionMode"           Value="Single"/>
            <Setter Property="ColumnHeaderHeight"      Value="36"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"      Value="#F5F6F8"/>
            <Setter Property="Foreground"      Value="#6B7280"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Padding"         Value="12,0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush"     Value="#E5E7EB"/>
        </Style>

        <!-- Секція правої панелі -->
        <Style x:Key="PanelSection" TargetType="Border">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="BorderBrush"     Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="8"/>
            <Setter Property="Margin"          Value="0,0,0,8"/>
        </Style>

        <!-- Заголовок секції -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="Margin"     Value="10,8,10,6"/>
        </Style>

        <!-- Кнопка-операція у правій панелі -->
        <Style x:Key="OperationBtn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding"         Value="10,8"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Foreground"      Value="#2D3142"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" BorderBrush="#F0F1F3" BorderThickness="0,0,0,1">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F5F8FC"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#C0C4CC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Іконка-кружок -->
        <Style x:Key="IconCircle" TargetType="Border">
            <Setter Property="Width"        Value="20"/>
            <Setter Property="Height"       Value="20"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Margin"       Value="0,0,8,0"/>
        </Style>

    </Window.Resources>

    <!-- Форма -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="26"/>
        </Grid.RowDefinitions>

        <!-- Верхня панель -->
        <Border Grid.Row="0" Background="White"
                BorderBrush="#E5E7EB" BorderThickness="0,0,0,1"
                Padding="16,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Назва -->
                    <TextBlock Text="Бронювання квитків" FontSize="20" FontWeight="SemiBold"
                               VerticalAlignment="Center" Foreground="#1A1F2E"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="0,0,0,0">
                    <Border Background="#EEF2F7" CornerRadius="12" Padding="10,4" Margin="0,0,8,0">
                        <TextBlock x:Name="TodayLabel" FontSize="12" Foreground="#5A6270"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ТАБЛИЦЯ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="260" MinWidth="220"/>
            </Grid.ColumnDefinitions>

            <!-- ЛІВА ЧАСТИНА -->
            <Border Grid.Column="0" Background="White" Margin="12,12,6,12"
                    BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10">
                <DockPanel>

                    <!-- Пошук, фільтри -->
                    <Border DockPanel.Dock="Top" Padding="12,8" BorderBrush="#F0F1F3" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Пошук -->
                            <StackPanel Orientation="Horizontal" Grid.Column="0">
                                <TextBox x:Name="SearchNameInput" Width="200" Margin="0,0,8,0"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Пошук за назвою фільму"/>
                                <Button Content="Знайти" Style="{StaticResource PrimaryBtn}"  Width="70" Command="{Binding ApplySortCommand}"/>
                            </StackPanel>

                            <!-- Фільтри -->
                            <StackPanel Orientation="Horizontal" Grid.Column="1" Margin="12,0,0,0">
                                <ToggleButton Content="Всі" Style="{StaticResource FilterChip}" Margin="0,0,4,0" IsChecked="True" Tag="Всі"/>
                                <ToggleButton Content="VIP" Style="{StaticResource FilterChip}" Margin="0,0,4,0" Tag="VIP"/>
                                <ToggleButton Content="IMAX" Style="{StaticResource FilterChip}" Margin="0,0,4,0" Tag="IMAX"/>
                                <ToggleButton Content="Скасовані"  Style="{StaticResource FilterChip}" Tag="Скасовані"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- DataGrid -->
                    <DataGrid x:Name="BookingsDataGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              
                              ItemsSource="{Binding Reservations}"
                              SelectedItem="{Binding Selected, Mode=TwoWay}">

                        <!-- Скасовані записи -->
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCanceled}" Value="True">
                                        <Setter Property="Foreground" Value="#A0A8B4"/>
                                        <Setter Property="FontStyle"  Value="Italic"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" 
                                Binding="{Binding Id}" 
                                Width="45" 
                                ElementStyle="{StaticResource IdGridCell}"/>
                            <DataGridTextColumn Header="Фільм" 
                                Binding="{Binding MovieTitle}" 
                                Width="*" 
                                ElementStyle="{StaticResource MovieGridCell}"/>
                            <DataGridTextColumn Header="Час" 
                                Binding="{Binding ShowTime, StringFormat=\{0:hh\\:mm\}}" 
                                Width="60" 
                                ElementStyle="{StaticResource CenterGridCell}"/>
                            <DataGridTextColumn Header="Формат" 
                                Binding="{Binding Format}" 
                                Width="70" 
                                ElementStyle="{StaticResource CenterGridCell}"/>
                            <DataGridTextColumn Header="Місце" 
                                Binding="{Binding SeatDisplay}" 
                                Width="60" 
                                ElementStyle="{StaticResource CenterGridCell}"/>
                            <DataGridTextColumn Header="Тип" 
                                Binding="{Binding TypeLabel}" 
                                Width="80" 
                                ElementStyle="{StaticResource CenterGridCell}"/>
                        </DataGrid.Columns>

                        <!-- Контекстне меню -->
                        <DataGrid.ContextMenu>
                            <ContextMenu FontFamily="Segoe UI" FontSize="12">
                                <MenuItem Header="Аналіз" IsEnabled="False"
                                          Foreground="#9CA3AF" FontWeight="SemiBold"/>
                                <Separator/>
                                <MenuItem Header="Об'єднати за фільмом"
                                          Command="{Binding PlacementTarget.DataContext.GroupCommand,
                                          RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                    <MenuItem.Icon>
                                        <TextBlock Text="⊕" Foreground="#0F6E56"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Збіг часу і місця (==)"
                                          Command="{Binding PlacementTarget.DataContext.CompareEqualityCommand,
                                          RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                    <MenuItem.Icon>
                                        <TextBlock Text="=" Foreground="#534AB7"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Який сеанс раніше (&lt;&gt;)"
                                          Command="{Binding PlacementTarget.DataContext.CompareTimeCommand,
                                          RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                    <MenuItem.Icon>
                                        <TextBlock Text="⟨⟩" Foreground="#534AB7"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="Експорт груп у файл"
                                          Command="{Binding PlacementTarget.DataContext.ExportGroupedCommand,
                                          RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                    <MenuItem.Icon>
                                        <TextBlock Text="↑" Foreground="#1A6FC4"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- ПРАВА ЧАСТИНА -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="6,12,12,12">
                <StackPanel>

                    <!-- Деталі та операції -->
                    <Border Style="{StaticResource PanelSection}">
                        <StackPanel>
                            <TextBlock Text="ОБРАНИЙ ЗАПИС" Style="{StaticResource SectionHeader}" Foreground="#9CA3AF"/>
                            <Border BorderBrush="#F0F1F3" BorderThickness="0,1,0,0" Padding="10,8">
                                <!-- Якщо нічого не обрано -->
                                <TextBlock x:Name="NoSelectionText" Text="Оберіть рядок у таблиці"
                                           Foreground="#B0B8C4" FontStyle="Italic" FontSize="12"
                                           Visibility="{Binding HasSelection, Converter={StaticResource BoolVis}, ConverterParameter=Inverse}"/>
                            </Border>
                            <!-- Деталі -->
                            <StackPanel x:Name="SelectionDetails" Margin="10,4,10,8"
                                        Visibility="{Binding HasSelection, Converter={StaticResource BoolVis}}">
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Фільм" Foreground="#9CA3AF" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Selected.MovieTitle}"
                                               FontWeight="SemiBold" FontSize="11" MaxWidth="120"
                                               TextWrapping="Wrap" TextAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Час / Формат" Foreground="#9CA3AF" FontSize="11"/>
                                    <TextBlock Grid.Column="1" FontSize="11" FontWeight="SemiBold">
                                        <Run Text="{Binding Selected.ShowTime, StringFormat=hh\\:mm}"/>
                                        <Run Text=" — "/>
                                        <Run Text="{Binding Selected.Format}"/>
                                    </TextBlock>
                                </Grid>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Місце" Foreground="#9CA3AF" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Selected.SeatDisplay}" FontSize="11" FontWeight="SemiBold"/>
                                </Grid>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Лаундж" Foreground="#9CA3AF" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Selected.LoungeDisplay}" FontSize="11" FontWeight="SemiBold"/>
                                </Grid>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Закуски" Foreground="#9CA3AF" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Selected.SnacksDisplay}" FontSize="11" FontWeight="SemiBold"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Операції над записом -->
                    <Border Style="{StaticResource PanelSection}">
                        <StackPanel>
                            <TextBlock Text="ЗАПИС" Style="{StaticResource SectionHeader}"/>
                            <Button Style="{StaticResource OperationBtn}" Command="{Binding AddCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource IconCircle}" Background="#E3EFFC">
                                        <TextBlock Text="+" FontWeight="Bold" Foreground="#1A6FC4"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontSize="14"/>
                                    </Border>
                                    <TextBlock Text="Додати бронювання" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource OperationBtn}" Command="{Binding DeleteCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource IconCircle}" Background="#FCEAEA">
                                        <TextBlock Text="✕" Foreground="#C0392B"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontSize="11"/>
                                    </Border>
                                    <TextBlock Text="Видалити запис" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource OperationBtn}" Command="{Binding CancelCommand}" BorderThickness="0">
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource IconCircle}" Background="#FEF3E2">
                                        <TextBlock Text="○" Foreground="#D4820A" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13"/>
                                    </Border>
                                    <TextBlock Text="Скасувати бронювання" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Сортування -->
                    <Border Style="{StaticResource PanelSection}">
                        <StackPanel>
                            <TextBlock Text="СОРТУВАННЯ" Style="{StaticResource SectionHeader}"/>
                            <Border Padding="10,6,10,6" BorderBrush="#F0F1F3" BorderThickness="0,1,0,0">
                                <ComboBox x:Name="SortComboBox"
                                          SelectedIndex="{Binding SortIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="Сортувати: за часом"/>
                                    <ComboBoxItem Content="Сортувати: за назвою"/>
                                    <ComboBoxItem Content="Сортувати: за місцем"/>
                                </ComboBox>
                            </Border>
                            <Button Style="{StaticResource OperationBtn}"
                                    Command="{Binding ApplySortCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource IconCircle}" Background="#F5F6F8">
                                        <TextBlock Text="⇅" Foreground="#6B7280" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                                    </Border>
                                    <TextBlock Text="Застосувати сортування" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource OperationBtn}" BorderThickness="0"
                                    >
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource IconCircle}" Background="#F5F6F8">
                                        <TextBlock Text="↺" Foreground="#6B7280" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/>
                                    </Border>
                                    <TextBlock Text="Оновити список" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Статистика -->
                    <Border Style="{StaticResource PanelSection}">
                        <StackPanel>
                            <TextBlock Text="СТАТИСТИКА" Style="{StaticResource SectionHeader}"/>
                            <Border Padding="10,8" BorderBrush="#F0F1F3" BorderThickness="0,1,0,0">
                                <StackPanel>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Усього записів" Foreground="#9CA3AF" FontSize="11"/>
                                        <TextBlock x:Name="StatTotal" Grid.Column="1" FontSize="11" FontWeight="SemiBold"/>
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="VIP місць" Foreground="#9CA3AF" FontSize="11"/>
                                        <TextBlock x:Name="StatVip" Grid.Column="1" FontSize="11" FontWeight="SemiBold" Foreground="#854F0B"/>
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="IMAX сеансів" Foreground="#9CA3AF" FontSize="11"/>
                                        <TextBlock x:Name="StatImax" Grid.Column="1" FontSize="11" FontWeight="SemiBold" Foreground="#0F6E56"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Нижня панель -->
        <Border Grid.Row="2" Background="#F5F6F8" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="16,0">
            <TextBlock x:Name="StatusBar" Text="{Binding StatusMessage}" VerticalAlignment="Center" FontSize="11" Foreground="#9CA3AF"/>
        </Border>
    </Grid>
</Window>
