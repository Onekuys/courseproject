<Window x:Class="OOPWPFProject.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OOPWPFProject"
        mc:Ignorable="d"
        Title="Система бронювання квитків" Height="600" Width="1024" FontSize="14" FontFamily="Verdana">


    <!-- Styles -->
    <Window.Resources>
        
        <!-- Головні кнопки -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                            CornerRadius="8" 
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#005A9E"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Другорядні кнопки -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#CCCCCC"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#AAAAAA"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- Блоки вводу тексту -->
        <Style TargetType="TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                            BorderBrush="#CCCCCC" 
                            BorderThickness="1" 
                            CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Надписи -->
        <Style TargetType="Label">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="0,0,0,5"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="BorderBrush" Value="#005A9E"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#005A9E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowHeight" Value="25"/>
            <Setter Property="AlternatingRowBackground" Value="#F9F9F9"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EEEEEE"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
        </Style>
    </Window.Resources>


    <!-- Форма -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- БРОНЮВАННЯ КВИТКІВ -->
        <Border Grid.Column="0" Background="#F0F0F0" Padding="10">

            <StackPanel x:Name="InputForm">
                <TextBlock Text="Бронювання квитків" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

                <!-- Назва фільму -->
                <Label Content="Назва фільму:"/>
                <TextBox x:Name="MovieTitleInput" Height="30" Margin="0,0,0,5" VerticalContentAlignment="Center"/>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Час сеансу -->
                    <StackPanel Grid.Column="0">
                        <Label Content="Час сеансу:"/>
                        <TextBox x:Name="ShowtimeInput" Height="30"/>
                    </StackPanel>
                    
                    <!-- Номер місця -->
                    <StackPanel Grid.Column="2">
                        <Label Content="Номер місця:"/>
                        <TextBox x:Name="SeatNumberInput" Height="30"/>
                    </StackPanel>
                </Grid>

                <!-- Формат -->
                <Label Content="Формат (необов'язково):"/>
                <ComboBox x:Name="FormatInput" Height="30" Margin="0,0,0,10">
                    <ComboBoxItem Content="2D"/>
                    <ComboBoxItem Content="3D"/>
                    <ComboBoxItem Content="IMAX"/>
                </ComboBox>

                <!-- Додаткові побажання -->
                <Label Content="Додаткові побажання (необов'язково):"/>
                <TextBox x:Name="AdditionalInfoInput" Height="75" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,10"/>

                <!-- Кнопки -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" >
                    <Button x:Name="SubmitButton" Content="Забронювати" Click="AddRecord_Click" Style="{StaticResource PrimaryButtonStyle}"  Width="130" Height="30" Margin="0,0,10,0"/>
                    <Button x:Name="DeleteButton" Content="Видалити" Click="DeleteRecord_Click" Style="{StaticResource SecondaryButtonStyle}" Width="130" Height="30" Margin="0,0,10,0"/>
                    <Button x:Name="ClearButton" Content="Очистити" Click="ClearForm_Click" Style="{StaticResource SecondaryButtonStyle}" Width="130" Height="30"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ІСТОРІЯ БРОНЮВАНЬ -->
        <Border Grid.Column="1" Background="White" Padding="10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Історія бронювань" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

                <DataGrid x:Name="BookingsDataGrid" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Назва фільму" Binding="{Binding MovieTitle}" Width="*"/>
                        <DataGridTextColumn Header="Час сеансу" Binding="{Binding Showtime, StringFormat=\{0:hh\\:mm\}}" Width="*"/>
                        <DataGridTextColumn Header="Номер місця" Binding="{Binding SeatNumber}" Width="*"/>
                        <DataGridTextColumn Header="Формат" Binding="{Binding MovieFormat}" Width="*"/>
                        <DataGridTextColumn Header="Додаткові побажання" Binding="{Binding AdditionalWishes}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</Window>
