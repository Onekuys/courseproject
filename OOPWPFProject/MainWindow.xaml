<Window x:Class="OOPWPFProject.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OOPWPFProject"
        mc:Ignorable="d"
        Title="Система бронювання квитків" Height="700" Width="1200" FontSize="14" FontFamily="Verdana">


    <!-- Styles -->
    <Window.Resources>
        
        <!-- Головні кнопки -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                            CornerRadius="8" 
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#005A9E"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Другорядні кнопки -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#CCCCCC"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#AAAAAA"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- Блоки вводу тексту -->
        <Style TargetType="TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                            BorderBrush="#CCCCCC" 
                            BorderThickness="1" 
                            CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Надписи -->
        <Style TargetType="Label">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="0,0,0,5"/>
        </Style>
        <!-- DataGrid Заголовок -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="BorderBrush" Value="#005A9E"/>
        </Style>
        <!-- DataGrid -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#005A9E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowHeight" Value="25"/>
            <Setter Property="AlternatingRowBackground" Value="#F9F9F9"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EEEEEE"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
        </Style>
    </Window.Resources>


    <!-- Форма -->
    <Grid>
        
        <!-- Список бронювань -->
        <Border Grid.Column="1" Background="White" Padding="10">
            <DockPanel>
                
                <TextBlock DockPanel.Dock="Top" Text="Список бронювань" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>
                <!-- Сортування -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                    <Label Content="Сортувати за: "/>
                    <ComboBox x:Name="SortComboBox" Width="158" Margin="0,0,10,0" SelectedIndex="0">
                        <ComboBoxItem Content="Назва фільму"/>
                        <ComboBoxItem Content="Час сеансу"/>
                        <ComboBoxItem Content="Номер місця"/>
                    </ComboBox>
                    <Button Content="Сортувати" Click="SortRecords_Click" Style="{StaticResource PrimaryButtonStyle}" Width="100" Height="25"/>
                </StackPanel>
                
                <!-- Пошук за індексом -->
                <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">

                    <Button x:Name="OpenReservationButton" Content="Додати запис" Click="OpenReservationWindow_Click" Style="{StaticResource PrimaryButtonStyle}" Width="150" Height="30" HorizontalAlignment="Left" />
                    <Button x:Name="DeleteButton" Content="Видалити" Click="DeleteRecord_Click" Style="{StaticResource SecondaryButtonStyle}" Width="150" Height="30" Margin="165,0,0,0" HorizontalAlignment="Left" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Label Content="Знайти за назвою:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox x:Name="SearchNameInput" Width="120" Height="30" Margin="0,0,10,0"/>
                        <Button Content="Пошук" Click="SearchName_Click" Style="{StaticResource PrimaryButtonStyle}" Width="100" Height="25"/>
                    </StackPanel>

                </Grid>
                
                <!-- DataGrid -->
                <DataGrid x:Name="BookingsDataGrid" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Назва фільму" Binding="{Binding MovieTitle}" Width="*"/>
                        <DataGridTextColumn Header="Час сеансу" Binding="{Binding ShowTime, StringFormat=\{0:hh\\:mm\}}" Width="*"/>
                        <DataGridTextColumn Header="Місце" Binding="{Binding SeatNumber}" Width="*"/>
                        <DataGridTextColumn Header="Деталі" Binding="{Binding Details}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
                
            </DockPanel>
            
        </Border>
    </Grid>
</Window>
