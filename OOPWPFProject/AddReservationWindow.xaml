<Window x:Class="OOPWPFProject.AddReservationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OOPWPFProject"
        mc:Ignorable="d"
        Title="Додавання запису" Height="600" Width="1024" FontSize="14" FontFamily="Verdana"
        Background="#F0F0F0">


    <!-- Styles -->
    <Window.Resources>

         <!--Головні кнопки--> 
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                            CornerRadius="8" 
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#005A9E"/>
                </Trigger>
            </Style.Triggers>
        </Style>

         <!--Другорядні кнопки--> 
        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#CCCCCC"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#AAAAAA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

         <!--Блоки вводу тексту--> 
        <Style TargetType="TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                            BorderBrush="#CCCCCC" 
                            BorderThickness="1" 
                            CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
         <!--Надписи--> 
        <Style TargetType="Label">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="0,0,0,5"/>
        </Style>

         <!--Список--> 
        <Style TargetType="ComboBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0,30,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Border" 
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4"/>

                            <ToggleButton x:Name="ToggleButton" 
                          Background="Transparent" 
                          BorderBrush="Transparent"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Grid>
                                            <Border Background="Transparent"/>
                                            <Path x:Name="Arrow" 
                                  Data="M0,0 L4,4 L8,0 Z" 
                                  Fill="#666666" 
                                  HorizontalAlignment="Right" 
                                  VerticalAlignment="Center" 
                                  Margin="0,0,10,0"/>
                                        </Grid>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="ContentSite" 
                              IsHitTestVisible="False" 
                              Content="{TemplateBinding SelectionBoxItem}" 
                              Margin="{TemplateBinding Padding}" 
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" 
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>

                            <Popup x:Name="Popup" 
                   Placement="Bottom" 
                   IsOpen="{TemplateBinding IsDropDownOpen}" 
                   AllowsTransparency="True" 
                   Focusable="False">
                                <Border x:Name="DropDownBorder" 
                        Background="White" 
                        BorderBrush="#CCCCCC" 
                        BorderThickness="1" 
                        CornerRadius="4" 
                        Margin="0,2,0,0"
                        MinWidth="{TemplateBinding ActualWidth}" 
                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer>
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#AAAAAA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
         <!--DataGrid Заголовок--> 
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="BorderBrush" Value="#005A9E"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <StackPanel x:Name="InputForm">
            <TextBlock Text="Бронювання квитків" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

             <!--Назва фільму--> 
            <Label Content="Назва фільму:"/>
            <TextBox x:Name="MovieTitleInput" Height="30" Margin="0,0,0,5" VerticalContentAlignment="Center"/>
            <Label Content="Дата сеансу:"/>
            <DatePicker x:Name="DateInput" Height="30" Margin="0,0,0,10"/>

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
					<ColumnDefinition Width="10"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                 <!--Час сеансу--> 
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <Label Content="Час сеансу:"/>
                    <TextBox x:Name="ShowtimeInput" Height="30"/>
                </StackPanel>

                 <!--Номер місця--> 
                <StackPanel Grid.Column="2">
                    <Label Content="Номер місця:"/>
                    <TextBox x:Name="SeatNumberInput" Height="30"/>
                </StackPanel>
				
				 <!--Лаундж зона--> 
				<StackPanel Grid.Column="4" HorizontalAlignment="Center">
					<Label Content="Лаундж зона:"/>
					<RadioButton x:Name="Lounge1Input" Content="Так" Height="30"/>
					<RadioButton x:Name="Lounge2Input" Content="Ні" Height="30"/>
				</StackPanel>

				 <!--Додаткові снеки--> 
				<StackPanel Grid.Column="6" HorizontalAlignment="Center">
					<Label Content="Додаткові закуски:"/>
					<RadioButton x:Name="Snacks1Input" Content="Так" Height="30"/>
					<RadioButton x:Name="Snacks2Input" Content="Ні" Height="30"/>
				</StackPanel>
            </Grid>

             <!--Формат--> 
            <Label Content="Формат:"/>
            <ComboBox x:Name="FormatInput" Height="30" Margin="0,0,0,10">
                <ComboBoxItem Content="2D"/>
                <ComboBoxItem Content="3D"/>
                <ComboBoxItem Content="IMAX"/>
            </ComboBox>

            <Label Content="Додаткові побажання (тільки VIP): "/>
            <TextBox x:Name="AdditionalInfoInput" Height="30" Margin="0,0,0,10"/>

             <!--Кнопки--> 
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" >
                <Button x:Name="SubmitButton" Content="Забронювати" Click="AddRecord_Click" Style="{StaticResource PrimaryButtonStyle}"  Width="130" Height="30" Margin="0,0,10,0"/>
                <Button x:Name="ClearButton" Content="Очистити" Click="ClearForm_Click" Style="{StaticResource SecondaryButtonStyle}" Width="130" Height="30"/>
            </StackPanel>
             
        </StackPanel>
    </Grid>
    
</Window>