<Window x:Class="OOPWPFProject.AddReservationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Нове бронювання" Height="680" Width="860"
        FontSize="13" FontFamily="Verdana"
        Background="#F4F6F9"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- Кнопки -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="14,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#005A9E"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#CCCCCC"/>
                    <Setter Property="Foreground" Value="#888888"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#BDBDBD"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Місце (вільне) -->
        <Style x:Key="SeatFree" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Background" Value="#E8F5E9"/>
            <Setter Property="Foreground" Value="#2E7D32"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#A5D6A7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C8E6C9"/>
                    <Setter Property="BorderBrush" Value="#66BB6A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Місце — зайняте -->
        <Style x:Key="SeatTaken" TargetType="Button" BasedOn="{StaticResource SeatFree}">
            <Setter Property="Background" Value="#FFEBEE"/>
            <Setter Property="Foreground" Value="#C62828"/>
            <Setter Property="BorderBrush" Value="#EF9A9A"/>
            <Setter Property="IsEnabled" Value="False"/>
            <Setter Property="Cursor" Value="No"/>
        </Style>

        <!-- Місце — обране -->
        <Style x:Key="SeatSelected" TargetType="Button" BasedOn="{StaticResource SeatFree}">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#005A9E"/>
        </Style>

        <!-- Картка-секція -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.08" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Label -->
        <Style TargetType="Label">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#444444"/>
            <Setter Property="Padding" Value="0,0,0,4"/>
        </Style>

        <!-- ComboBox -->
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    
    <!-- Форма -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">

            <!-- Заголовок -->
            <TextBlock Text="Бронювання" FontSize="24" FontWeight="Bold"
                       Foreground="#1A1A2E" Margin="0,0,0,16"/>

            <!-- Вибір фільму та дати -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="1. Оберіть фільм та дату" FontWeight="Bold" Foreground="#007ACC" Margin="0,0,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <Label Content="Фільм:"/>
                            <ComboBox x:Name="MovieComboBox" DisplayMemberPath="Title" SelectionChanged="MovieComboBox_SelectionChanged"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <Label Content="Дата:"/>
                            <DatePicker x:Name="DateInput" Height="34" SelectedDateChanged="DateInput_SelectedDateChanged" 
                                        SelectedDate="{x:Static system:DateTime.Today}" 
                                        xmlns:system="clr-namespace:System;assembly=mscorlib"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Вибір сеансу -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="2. Оберіть сеанс" FontWeight="Bold" Foreground="#007ACC" Margin="0,0,0,12"/>
                    <Label Content="Сеанс (час та формат):"/>
                    <ComboBox x:Name="ShowtimeComboBox" IsEnabled="False" SelectionChanged="ShowtimeComboBox_SelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <Run Text="{Binding Time, StringFormat=\{0:hh\\:mm\}}"/>
                                    <Run Text=" | "/>
                                    <Run Text="{Binding Format}"/>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- Схема залу -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="3. Оберіть місце" FontWeight="Bold" Foreground="#007ACC" Margin="0,0,0,8"/>

                    <!-- Легенда -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Border Width="14" Height="14" Background="#E8F5E9" BorderBrush="#A5D6A7" BorderThickness="1" CornerRadius="2" Margin="0,0,4,0"/>
                        <TextBlock Text="Вільне" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="#555"/>
                        <Border Width="14" Height="14" Background="#007ACC" CornerRadius="2" Margin="0,0,4,0"/>
                        <TextBlock Text="Обране" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="#555"/>
                        <Border Width="14" Height="14" Background="#FFEBEE" BorderBrush="#EF9A9A" BorderThickness="1" CornerRadius="2" Margin="0,0,4,0"/>
                        <TextBlock Text="Зайняте" VerticalAlignment="Center" Foreground="#555"/>
                    </StackPanel>

                    <!-- Екран -->
                    <Border Background="#E3F2FD" CornerRadius="4" Margin="20,0,20,12" Padding="8,4">
                        <TextBlock Text="🎬 ЕКРАН" HorizontalAlignment="Center" FontWeight="Bold" Foreground="#1565C0" FontSize="11"/>
                    </Border>

                    <!-- Сітка місць -->
                    <ItemsControl x:Name="SeatsPanel" IsEnabled="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                
                                <StackPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <TextBlock x:Name="SelectedSeatLabel" Text="Місце не обрано" Margin="0,10,0,0" Foreground="#888888" FontStyle="Italic"/>
                </StackPanel>
            </Border>

            <!-- Додаткові опції -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="4. Додаткові опції" FontWeight="Bold" Foreground="#007ACC" Margin="0,0,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Лаундж зона -->
                        <StackPanel Grid.Column="0">
                            <Label Content="Лаундж зона:"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="LoungeYes" Content="Так" Margin="0,0,16,0" GroupName="Lounge"/>
                                <RadioButton x:Name="LoungeNo" Content="Ні" IsChecked="True" GroupName="Lounge"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Закуски -->
                        <StackPanel Grid.Column="2">
                            <Label Content="Додаткові закуски:"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="SnacksYes" Content="Так" Margin="0,0,16,0" GroupName="Snacks"/>
                                <RadioButton x:Name="SnacksNo" Content="Ні" IsChecked="True" GroupName="Snacks"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <Label Content="Додаткові побажання (тільки VIP):" Margin="0,10,0,0"/>
                    <TextBox x:Name="WishesInput" Height="34" Padding="8,0" VerticalContentAlignment="Center" IsEnabled="False"/>
                </StackPanel>
            </Border>

            <!-- Кнопки -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                <Button Content="Очистити" Style="{StaticResource SecondaryBtn}" Width="110" Margin="0,0,10,0" Click="ClearForm_Click"/>
                <Button x:Name="SubmitButton" Content="Забронювати" Style="{StaticResource PrimaryBtn}" Width="140" IsEnabled="False" Click="AddRecord_Click"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Window>
