<Window x:Class="OOPWPFProject.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OOPWPFProject"
        xmlns:helpers="clr-namespace:OOPWPFProject.Helpers"
        mc:Ignorable="d"
        Title="Бронювання квитків"
        Height="660" Width="1100"
        MinHeight="500" MinWidth="800"
        FontFamily="Segoe UI" FontSize="13"
        Background="#F2F3F5"
        Closing="Window_Closing">

    <!-- СТИЛІ -->
    <Window.Resources>
        <helpers:PercentToWidthConverter x:Key="PercentToWidthConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>

        <!-- Основна кнопка -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background"   Value="#1A6FC4"/>
            <Setter Property="Foreground"   Value="White"/>
            <Setter Property="FontSize"     Value="12"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"      Value="12,0"/>
            <Setter Property="Height"       Value="28"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#155AA3"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#A8C4E0"/>
                    <Setter Property="Foreground" Value="#D0E4F4"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Червона кнопка -->
        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#C0392B"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#9B2D20"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#E8B4AF"/>
                    <Setter Property="Foreground" Value="#F5D5D0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Помаранчева кнопка -->
        <Style x:Key="WarnBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#D4820A"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#B36E09"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#EECC99"/>
                    <Setter Property="Foreground" Value="#F5E4C0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Кнопка-фільтр -->
        <Style x:Key="FilterChip" TargetType="ToggleButton">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="Foreground"      Value="#5A6270"/>
            <Setter Property="BorderBrush"     Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Padding"         Value="10,3"/>
            <Setter Property="Height"          Value="24"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background"  Value="#E3EFFC"/>
                    <Setter Property="Foreground"  Value="#1A6FC4"/>
                    <Setter Property="BorderBrush" Value="#93BEE8"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEF2F7"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding"                  Value="8,0"/>
            <Setter Property="Height"                   Value="28"/>
            <Setter Property="FontSize"                 Value="12"/>
            <Setter Property="Foreground"               Value="#2D3142"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox -->
        <Style TargetType="ComboBox">
            <Setter Property="Height"       Value="28"/>
            <Setter Property="FontSize"     Value="12"/>
            <Setter Property="Background"   Value="White"/>
            <Setter Property="BorderBrush"  Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"      Value="8,0,24,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="5"/>
                            <ToggleButton Background="Transparent" BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                          RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Grid>
                                            <Border Background="Transparent"/>
                                            <Path Data="M0,0 L4,4 L8,0 Z" Fill="#666"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Margin="0,0,8,0"/>
                                        </Grid>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False">
                                <Border Background="White" BorderBrush="#D1D5DB" BorderThickness="1"
                                        CornerRadius="5" Margin="0,2,0,0"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer>
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F0F5FB"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E3EFFC"/>
                                <Setter Property="Foreground" Value="#1A6FC4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cells -->
        <Style x:Key="IdGridCell" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="12,0,0,0"/>
        </Style>

        <Style x:Key="MovieGridCell" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="12,0"/>
        </Style>

        <Style x:Key="CenterGridCell" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- Мітка деталей -->
        <Style x:Key="DetailLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="FontSize"   Value="11"/>
        </Style>
        <Style x:Key="DetailValue" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="MaxWidth"   Value="130"/>
        </Style>



        <!-- DataGrid -->
        <Style TargetType="DataGrid">
            <Setter Property="Background"              Value="White"/>
            <Setter Property="BorderThickness"         Value="0"/>
            <Setter Property="RowHeight"               Value="32"/>
            <Setter Property="GridLinesVisibility"     Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#F0F1F3"/>
            <Setter Property="AlternatingRowBackground" Value="#FAFBFC"/>
            <Setter Property="RowBackground"           Value="White"/>
            <Setter Property="HeadersVisibility"       Value="Column"/>
            <Setter Property="SelectionMode"           Value="Single"/>
            <Setter Property="ColumnHeaderHeight"      Value="36"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"      Value="#F5F6F8"/>
            <Setter Property="Foreground"      Value="#6B7280"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Padding"         Value="12,0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush"     Value="#E5E7EB"/>
        </Style>

        <!-- Секція правої панелі -->
        <Style x:Key="PanelSection" TargetType="Border">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="BorderBrush"     Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="8"/>
            <Setter Property="Margin"          Value="0,0,0,8"/>
        </Style>

        <!-- Заголовок секції -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="Margin"     Value="10,8,10,6"/>
        </Style>

        <!-- Кнопка-операція у правій панелі -->
        <Style x:Key="OperationBtn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding"         Value="10,8"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Foreground"      Value="#2D3142"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" BorderBrush="#F0F1F3" BorderThickness="0,0,0,1">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F5F8FC"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#C0C4CC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Іконка-кружок -->
        <Style x:Key="IconCircle" TargetType="Border">
            <Setter Property="Width"        Value="20"/>
            <Setter Property="Height"       Value="20"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Margin"       Value="0,0,8,0"/>
        </Style>


    </Window.Resources>

    <!-- Форма -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="26"/>
        </Grid.RowDefinitions>

        <!-- Верхня панель -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="16,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Назва -->
                    <TextBlock Text="Бронювання квитків" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#1A1F2E"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="0,0,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,0,0">
                        <DatePicker x:Name ="DateCalendar" SelectedDate="{Binding SelectedDate, Mode=TwoWay}"
                                    Width="140" Height="28" Margin="0,0,8,0"
                                    BorderThickness="0" Background="Transparent"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ТАБЛИЦЯ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="260" MinWidth="220"/>
            </Grid.ColumnDefinitions>

            <!-- ЛІВА ЧАСТИНА -->
            <Border Grid.Column="0" Background="White" Margin="12,12,6,12"
                    BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10">
                <DockPanel>

                    <!-- Пошук, фільтри -->
                    <Border DockPanel.Dock="Top" Padding="12,8" BorderBrush="#F0F1F3" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Пошук -->
                            <StackPanel Orientation="Horizontal" Grid.Column="0">
                                <TextBox x:Name="SearchNameInput" Width="200" Margin="0,0,8,0"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Пошук за назвою фільму"/>
                                <Button Content="Знайти" Style="{StaticResource PrimaryBtn}"  Width="70" Command="{Binding ApplySortCommand}"/>
                            </StackPanel>

                            <!-- Фільтри -->
                            <StackPanel Orientation="Horizontal" Grid.Column="1" Margin="12,0,0,0">
                                <ToggleButton Content="Всі" Style="{StaticResource FilterChip}" Margin="0,0,4,0" IsChecked="True" Click="FilterChip_Click" Tag="Всі"/>
                                <ToggleButton Content="VIP" Style="{StaticResource FilterChip}" Margin="0,0,4,0" Click="FilterChip_Click" Tag="VIP"/>
                                <ToggleButton Content="IMAX" Style="{StaticResource FilterChip}" Margin="0,0,4,0" Click="FilterChip_Click" Tag="IMAX"/>
                                <ToggleButton Content="Скасовані" Style="{StaticResource FilterChip}" Click="FilterChip_Click" Tag="Скасовані"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- DataGrid -->
                    <DataGrid x:Name="BookingsDataGrid" AutoGenerateColumns="False" IsReadOnly="True" ItemsSource="{Binding Reservations}"
                              SelectedItem="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">

                        <!-- Скасовані записи -->
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCanceled}" Value="True">
                                        <Setter Property="Foreground" Value="#A0A8B4"/>
                                        <Setter Property="FontStyle"  Value="Italic"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Id}" 
                                Width="45" 
                                ElementStyle="{StaticResource IdGridCell}"/>
                            <DataGridTextColumn Header="Фільм" Binding="{Binding MovieTitle}" 
                                Width="160" 
                                ElementStyle="{StaticResource MovieGridCell}"/>
                            <DataGridTextColumn Header="Час" Binding="{Binding ShowTime, StringFormat=\{0:hh\\:mm\}}" 
                                Width="60" 
                                ElementStyle="{StaticResource CenterGridCell}"/>
                            <DataGridTextColumn Header="Формат" Binding="{Binding Format}" 
                                Width="70" 
                                ElementStyle="{StaticResource CenterGridCell}"/>
                            <DataGridTextColumn Header="Місце" Binding="{Binding SeatDisplay}" 
                                Width="60" 
                                ElementStyle="{StaticResource CenterGridCell}"/>
                            <DataGridTextColumn Header="Тип" Binding="{Binding TypeLabel}" 
                                Width="80" 
                                ElementStyle="{StaticResource CenterGridCell}"/>
                            <DataGridTextColumn Header="Деталі" 
                                Binding="{Binding Details}" 
                                Width="*" 
                                ElementStyle="{StaticResource MovieGridCell}"/>
                        </DataGrid.Columns>

                        <!-- Контекстне меню -->
                        <DataGrid.ContextMenu>
                            <ContextMenu FontFamily="Segoe UI" FontSize="12">
                                <MenuItem Header="Аналіз" IsEnabled="False"
                                          Foreground="#9CA3AF" FontWeight="SemiBold"/>
                                <Separator/>
                                <MenuItem Header="Об'єднати за фільмом"
                                          Command="{Binding PlacementTarget.DataContext.GroupCommand,
                                          RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                    <MenuItem.Icon>
                                        <TextBlock Text="⊕" Foreground="#0F6E56"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Який сеанс раніше (&lt;&gt;)"
                                          Command="{Binding PlacementTarget.DataContext.CompareTimeCommand,
                                          RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                    <MenuItem.Icon>
                                        <TextBlock Text="⟨⟩" Foreground="#534AB7"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="Експорт усіх бронювань у файл"
                                          Command="{Binding PlacementTarget.DataContext.ExportGroupedCommand,
                                          RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                    <MenuItem.Icon>
                                        <TextBlock Text="↑" Foreground="#1A6FC4"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- ПРАВА ЧАСТИНА -->
            <Border Grid.Column="1" Margin="6,12,12,12" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10" Background="White">   
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Перемикач вкладок -->
                    <Grid Grid.Row="0" Background="#F5F6F8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ToggleButton x:Name="TabRecord" Grid.Column="0" Content="Запис" IsChecked="True" FontSize="12" FontWeight="SemiBold"
                             Background="White" BorderThickness="0,0,0,2"
                             BorderBrush="#1A6FC4" Foreground="#1A6FC4"
                             Click="TabRecord_Click"/>
                        <ToggleButton x:Name="TabStats" Grid.Column="1" Content="Статистика" FontSize="12" FontWeight="SemiBold"
                             Background="Transparent" BorderThickness="0"
                             Foreground="#9CA3AF"
                             Click="TabStats_Click"/>  
                    </Grid>

                    <!-- ВКЛАДКА: Запис -->
                    <ScrollViewer x:Name="PanelRecord" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,4,0,0">
                            <!-- Деталі та операції -->
                            <Border Style="{StaticResource PanelSection}">
                                <StackPanel>
                                    <TextBlock Text="ОБРАНИЙ ЗАПИС" Style="{StaticResource SectionHeader}" Foreground="#9CA3AF"/>
                                    <Border BorderBrush="#F0F1F3" BorderThickness="0,1,0,0" Padding="10,8">
                                        <TextBlock x:Name="NoSelectionText" Text="Оберіть рядок у таблиці" Foreground="#B0B8C4" FontStyle="Italic" FontSize="12">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasSelection}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <!-- Деталі -->
                                    <StackPanel x:Name="SelectionDetails" Margin="10,4,10,8" >
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Selected}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>

                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Фільм:" Foreground="#9CA3AF" FontSize="11"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Selected.MovieTitle}" FontWeight="SemiBold" FontSize="11" MaxWidth="120" TextWrapping="Wrap" TextAlignment="Right"/>
                                        </Grid>

                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Час / Формат:" Foreground="#9CA3AF" FontSize="11"/>
                                            <TextBlock Grid.Column="1" FontSize="11" FontWeight="SemiBold" Text="{Binding Selected.ShowTime, StringFormat=hh\\:mm}"/>
                                        </Grid>

                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Місце:" Foreground="#9CA3AF" FontSize="11"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Selected.SeatDisplay}" FontSize="11" FontWeight="SemiBold"/>
                                        </Grid>

                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Лаундж:" Foreground="#9CA3AF" FontSize="11"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Selected.LoungeDisplay}" FontSize="11" FontWeight="SemiBold"/>
                                        </Grid>

                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Закуски:" Foreground="#9CA3AF" FontSize="11"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Selected.SnacksDisplay}" FontSize="11" FontWeight="SemiBold"/>
                                        </Grid>

                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Статус:" Foreground="#9CA3AF" FontSize="11"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Selected.PaidLabel}" FontSize="11" FontWeight="SemiBold"/>
                                        </Grid>

                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Скасовано:" Foreground="#9CA3AF" FontSize="11"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Selected.CancelLabel}" FontSize="11" FontWeight="SemiBold"/>
                                        </Grid>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Побажання:" Foreground="#9CA3AF" FontSize="11"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Selected.AdditionalDisplay}" FontSize="11" FontWeight="SemiBold"/>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Клієнт -->
                            <Border Style="{StaticResource PanelSection}">
                                <StackPanel>
                                    <TextBlock Text="КЛІЄНТ" Style="{StaticResource SectionHeader}"/>
                                    <Border Padding="10,8" BorderBrush="#F0F1F3" BorderThickness="0,1,0,0">
                                        <StackPanel>
                                            <!-- Ім'я -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Selected.ClientName}" FontWeight="SemiBold" FontSize="13" Foreground="#1A1F2E"/>  
                                                    <TextBlock Text="{Binding Selected.ClientRole}" FontSize="11" Foreground="#9CA3AF"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Телефон -->
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Телефон:" Foreground="#9CA3AF" FontSize="11"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Selected.ClientPhone}" FontSize="11" FontWeight="SemiBold"/>
                                            </Grid>

                                            <!-- Email -->
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="E-mail:" Foreground="#9CA3AF" FontSize="11"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Selected.ClientEmail}" FontSize="11" FontWeight="SemiBold" MaxWidth="120" TextTrimming="CharacterEllipsis"/>
                                            </Grid>

                                            <!-- Якщо немає клієнта -->
                                            <TextBlock Text="Бронювання без акаунту" FontSize="11" Foreground="#C0C4CC" FontStyle="Italic" Margin="0,4,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Selected.HasClient}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                            
                            <!-- Операції над записом -->
                            <Border Style="{StaticResource PanelSection}">
                                <StackPanel>
                                    <TextBlock Text="ЗАПИС" Style="{StaticResource SectionHeader}"/>
                                    <Button Style="{StaticResource OperationBtn}" Command="{Binding AddCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource IconCircle}" Background="#E3EFFC">
                                                <TextBlock Text="+" FontWeight="Bold" Foreground="#1A6FC4" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/>
                                            </Border>
                                            <TextBlock Text="Додати бронювання" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource OperationBtn}" Command="{Binding DeleteCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource IconCircle}" Background="#FCEAEA">
                                                <TextBlock Text="✕" Foreground="#C0392B" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                                            </Border>
                                            <TextBlock Text="Видалити запис" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource OperationBtn}" Command="{Binding CancelCommand}" BorderThickness="0">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource IconCircle}" Background="#FEF3E2">
                                                <TextBlock Text="○" Foreground="#D4820A" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13"/>
                                            </Border>
                                            <TextBlock Text="Скасувати бронювання" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Сортування -->
                            <Border Style="{StaticResource PanelSection}">
                                <StackPanel>
                                    <TextBlock Text="СОРТУВАННЯ" Style="{StaticResource SectionHeader}"/>
                                    <Border Padding="10,6,10,6" BorderBrush="#F0F1F3" BorderThickness="0,1,0,0">
                                        <ComboBox x:Name="SortComboBox"
                                          SelectedIndex="{Binding SortIndex, Mode=TwoWay}">
                                            <ComboBoxItem Content="Сортувати: за часом"/>
                                            <ComboBoxItem Content="Сортувати: за назвою"/>
                                            <ComboBoxItem Content="Сортувати: за місцем"/>
                                        </ComboBox>
                                    </Border>
                                    <Button Style="{StaticResource OperationBtn}" Command="{Binding ApplySortCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource IconCircle}" Background="#F5F6F8">
                                                <TextBlock Text="⇅" Foreground="#6B7280" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                                            </Border>
                                            <TextBlock Text="Застосувати сортування" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource OperationBtn}" BorderThickness="0">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource IconCircle}" Background="#F5F6F8">
                                                <TextBlock Text="↺" Foreground="#6B7280" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/>
                                            </Border>
                                            <TextBlock Text="Оновити список" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Статистика -->
                            <Border Style="{StaticResource PanelSection}">
                                <StackPanel>
                                    <TextBlock Text="СТАТИСТИКА" Style="{StaticResource SectionHeader}"/>
                                    <Border Padding="10,8" BorderBrush="#F0F1F3" BorderThickness="0,1,0,0">
                                        <StackPanel>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Усього записів" Foreground="#9CA3AF" FontSize="11"/>
                                                <TextBlock x:Name="StatTotal" Grid.Column="1" FontSize="11" FontWeight="SemiBold"/>
                                            </Grid>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="VIP місць" Foreground="#9CA3AF" FontSize="11"/>
                                                <TextBlock x:Name="StatVip" Grid.Column="1" FontSize="11" FontWeight="SemiBold" Foreground="#854F0B"/>
                                            </Grid>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="IMAX сеансів" Foreground="#9CA3AF" FontSize="11"/>
                                                <TextBlock x:Name="StatImax" Grid.Column="1" FontSize="11" FontWeight="SemiBold" Foreground="#0F6E56"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ВКЛАДКА: Статистика -->
                    <ScrollViewer x:Name="PanelStats" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10,8,10,12">

                            <!-- Метрики-картки -->
                            <TextBlock Text="ФІНАНСИ" Style="{StaticResource SectionHeader}"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#F5F6F8" CornerRadius="8" Padding="10,8">
                                    <StackPanel>
                                        <TextBlock Text="Дохід (грн)" FontSize="10" Foreground="#9CA3AF"/>
                                        <TextBlock Text="{Binding Stats.TotalRevenue, StringFormat={}{0:0}}" FontSize="18" FontWeight="SemiBold" Foreground="#1A1F2E"/>      
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Background="#F5F6F8" CornerRadius="8" Padding="10,8">
                                    <StackPanel>
                                        <TextBlock Text="Квитків" FontSize="10" Foreground="#9CA3AF"/>
                                        <TextBlock Text="{Binding Stats.TotalTickets}" FontSize="18" FontWeight="SemiBold" Foreground="#1A1F2E"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Style="{StaticResource PanelSection}">
                                <StackPanel Margin="10,8">
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="VIP дохід (грн)" FontSize="11" Foreground="#9CA3AF"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Stats.VipRevenue, StringFormat={}{0:0}}" FontSize="11" FontWeight="SemiBold" />
                                    </Grid>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Оплачено (грн)" FontSize="11" Foreground="#9CA3AF"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Stats.PaidRevenue, StringFormat={}{0:0}}" FontSize="11" FontWeight="SemiBold" />
                                    </Grid>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Скасовано квит." FontSize="11" Foreground="#9CA3AF"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Stats.CanceledCount}" FontSize="11" FontWeight="SemiBold" />
                                    </Grid>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Завантаж. залів" FontSize="11" Foreground="#9CA3AF"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Stats.AvgCapacity, StringFormat={}{0}%}" FontSize="11" FontWeight="SemiBold"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Топ фільмів -->
                            <TextBlock Text="ТОП ФІЛЬМІВ" Style="{StaticResource SectionHeader}" Margin="0,6,0,4"/>
                            <Border Style="{StaticResource PanelSection}">
                                <ItemsControl ItemsSource="{Binding Stats.MovieRevenues}" Margin="10,6">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock FontSize="10" Foreground="#9CA3AF">
                                                        <Run Text="{Binding Tickets}"/>
                                                        <Run Text=" квит."/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold">
                                                        <Run Text="{Binding Revenue, StringFormat={}{0:0}}"/>
                                                        <Run Text=" ₴" Foreground="#9CA3AF"/>
                                                </TextBlock>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>

                            <!-- Завантаженість сеансів -->
                            <TextBlock Text="СЕАНСИ" Style="{StaticResource SectionHeader}" Margin="0,6,0,4"/>
                            <Border Style="{StaticResource PanelSection}">
                                <ItemsControl ItemsSource="{Binding Stats.ShowtimeLoads}" Margin="10,6">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock FontSize="11" TextTrimming="CharacterEllipsis">
                                                        <Run Text="{Binding Time, StringFormat=\{0:hh\\:mm\}}"/>
                                                        <Run Text=" "/>
                                                        <Run Text="{Binding Title}"/>
                                                    </TextBlock>
                                                    <TextBlock Grid.Column="1" FontSize="11" FontWeight="SemiBold">
                                                        <Run Text="{Binding Percent}"/>
                                                        <Run Text="%" Foreground="#9CA3AF"/>
                                                    </TextBlock>
                                                </Grid>
                                                <!-- Прогрес-бар завантаженості -->
                                                <Grid Height="4" Margin="0,3,0,0">
                                                    <Border Background="#F0F1F3" CornerRadius="2"/>
                                                    <Border CornerRadius="2" HorizontalAlignment="Left" Background="#1A6FC4">
                                                        <Border.Width>
                                                            <MultiBinding Converter="{StaticResource PercentToWidthConverter}">
                                                                <Binding Path="Percent"/>
                                                                <Binding RelativeSource="{RelativeSource AncestorType=Grid}" Path="ActualWidth"/>
                                                            </MultiBinding>
                                                        </Border.Width>
                                                    </Border>
                                                </Grid>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Нижня панель -->
        <Border Grid.Row="2" Background="#F5F6F8" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="16,0">
            <TextBlock x:Name="StatusBar" Text="{Binding StatusMessage}" VerticalAlignment="Center" FontSize="11" Foreground="#9CA3AF"/>
        </Border>
    </Grid>
</Window>
