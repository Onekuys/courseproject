<Window x:Class="OOPWPFProject.Views.BrowseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CinemaBook — Сеанси"
        Height="620" Width="860"
        MinHeight="500" MinWidth="700"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13"
        Background="#F2F3F5">

    <Window.Resources>
        <!-- Кнопки -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background"   Value="#1A6FC4"/>
            <Setter Property="Foreground"   Value="White"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"      Value="14,0"/>
            <Setter Property="Height"       Value="32"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#155AA3"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#A8C4E0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GreenBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#0F6E56"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0A5240"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- DataGrid -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowHeight" Value="36"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#F0F1F3"/>
            <Setter Property="AlternatingRowBackground" Value="#FAFBFC"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="ColumnHeaderHeight" Value="36"/>
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F5F6F8"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
        </Style>

        <Style x:Key="CenterCell" TargetType="TextBlock">
            <Setter Property="VerticalAlignment"   Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="LeftCell" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin"            Value="12,0"/>
        </Style>
        
        <!-- ComboBox -->
        <Style TargetType="ComboBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0,30,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Border" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"/>

                            <ToggleButton x:Name="ToggleButton" 
                                Background="Transparent" 
                                BorderBrush="Transparent"
                                IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Grid>
                                            <Border Background="Transparent"/>
                                            <Path x:Name="Arrow" 
                                                Data="M0,0 L4,4 L8,0 Z" 
                                                Fill="#666666" 
                                                HorizontalAlignment="Right" 
                                                VerticalAlignment="Center" 
                                                Margin="0,0,10,0"/>
                                        </Grid>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="ContentSite" 
                                IsHitTestVisible="False" 
                                Content="{TemplateBinding SelectionBoxItem}" 
                                Margin="{TemplateBinding Padding}" 
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" 
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>

                            <Popup x:Name="Popup" 
                                Placement="Bottom" 
                                IsOpen="{TemplateBinding IsDropDownOpen}" 
                                AllowsTransparency="True" 
                                Focusable="False">
                            <Border x:Name="DropDownBorder" 
                                Background="White" 
                                BorderBrush="#CCCCCC" 
                                BorderThickness="1" 
                                CornerRadius="4" 
                                Margin="0,2,0,0"
                                MinWidth="{TemplateBinding ActualWidth}" 
                                MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer>
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#AAAAAA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="23"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0" Background="White"
                BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="16,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="CinemaBook" FontSize="18" FontWeight="Bold" Foreground="#1A1F2E" VerticalAlignment="Center"/>
                    <TextBlock Text="— Розклад сеансів" FontSize="14" Foreground="#6B7280" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="UserLabel" Text="Гість" Foreground="#6B7280" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"/>
                    <Button x:Name="LoginBtn" Content="Увійти / Реєстрація" 
                            Style="{StaticResource PrimaryBtn}" Width="160" Height="28" 
                            Click="LoginBtn_Click" Margin="0,0,8,0"/>
                    <Button x:Name="AdminBtn" Content="Адмін-панель"
                            Style="{StaticResource GreenBtn}" Width="140" Height="28" 
                            Click="AdminBtn_Click" Visibility="Collapsed"/>
                    <Button x:Name="MyTicketsBtn" Content="🎫 Мої квитки"
                            Style="{StaticResource PrimaryBtn}" Width="120" Height="28" 
                            Click="MyTicketsBtn_Click" Visibility="Collapsed" Margin="0,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Контент -->
        <Border Grid.Row="1" Background="White" Margin="12" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10">
            <DockPanel>
                <!-- Фільтр дати -->
                <Border DockPanel.Dock="Top" Padding="12,10" BorderBrush="#F0F1F3" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Дата:" VerticalAlignment="Center" Foreground="#6B7280" Margin="0,0,8,0"/>
                        <Border Background="White" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4" Height="28">
                            <DatePicker x:Name="DateInput" 
                                SelectedDateChanged="DateInput_SelectedDateChanged" 
                                SelectedDate="{x:Static system:DateTime.Today}" 
                                xmlns:system="clr-namespace:System;assembly=mscorlib"
                                BorderThickness="0" 
                                Background="Transparent"
                                VerticalContentAlignment="Center" 
                                Padding="4,0"/>         
                        </Border>
                        <TextBlock Text="Фільм:" VerticalAlignment="Center" Foreground="#6B7280" Margin="20,0,8,0"/>
                        <ComboBox x:Name="MovieFilter" Width="200" Height="28"
                                  SelectionChanged="MovieFilter_SelectionChanged"
                                  DisplayMemberPath="Title"/>
                        <Button Content="Скинути фільтр" Style="{StaticResource PrimaryBtn}"
                                Width="130" Height="28" Margin="8,0,0,0" Click="ResetFilter_Click"/>
                    </StackPanel>
                </Border>

                <!-- Таблиця сеансів -->
                <DataGrid x:Name="ShowtimesGrid"
                          AutoGenerateColumns="False"
                          SelectionChanged="ShowtimesGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Фільм"   Binding="{Binding Movie.Title}" Width="200" ElementStyle="{StaticResource LeftCell}"/>
                        <DataGridTextColumn Header="Дата"    Binding="{Binding Date, StringFormat=dd.MM.yyyy}" Width="90" ElementStyle="{StaticResource CenterCell}"/>
                        <DataGridTextColumn Header="Час"     Binding="{Binding Time, StringFormat=\{0:hh\\:mm\}}" Width="70" ElementStyle="{StaticResource CenterCell}"/>
                        <DataGridTextColumn Header="Формат"  Binding="{Binding Format}" Width="80" ElementStyle="{StaticResource CenterCell}"/>
                        <DataGridTextColumn Header="Вільних місць" Binding="{Binding FreeSeats}" Width="110" ElementStyle="{StaticResource CenterCell}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- Кнопка "Забронювати" (окремо внизу) -->
        <Border Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Right"
                Margin="24,0,34,20">
            <Button x:Name="BookBtn" Content="Забронювати місце"
                    Style="{StaticResource PrimaryBtn}"
                    Height="28" Padding="20,0" FontSize="14"
                    IsEnabled="False"
                    Click="BookBtn_Click"/>
        </Border>

        <!-- Статус -->
        <Border Grid.Row="2" Background="#F5F6F8" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="13,0">
            <TextBlock x:Name="StatusBar" Text="Оберіть сеанс для бронювання"
                       VerticalAlignment="Center" FontSize="11" Foreground="#9CA3AF"/>
        </Border>
    </Grid>
</Window>
